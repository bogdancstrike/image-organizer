# Copy to .env and adjust. Every variable is optional.

# Root folder the app may browse (mounted read-write at /library). You pick the exact
# working folder in the UI. Default: your home folder. Example to narrow it:
# LIBRARY_PATH=/home/me/Pictures
# Name shown in the headline: "Sorting my <LIBRARY_NAME> folder"
LIBRARY_NAME=Downloads

# Web UI port on the host
PORT=8080

# Files are moved as this user (`id -u` / `id -g` on the host)
PUID=1000
PGID=1000

# Optional AI. Without a key everything still works locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Name of the folder created inside the sorted folder
OUTPUT_DIR_NAME=Organized
# Analysis threads (default: number of CPUs)
WORKERS=
